import java.util.*;

class Solution {
    public int[] shortestAlternatingPaths(int n, int[][] redEdges, int[][] blueEdges) {

        // Create adjacency lists for red and blue edges
        List<Integer>[] redGraph = new ArrayList[n];
        List<Integer>[] blueGraph = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            redGraph[i] = new ArrayList<>();
            blueGraph[i] = new ArrayList<>();
        }

        for (int[] edge : redEdges) {
            redGraph[edge[0]].add(edge[1]);
        }

        for (int[] edge : blueEdges) {
            blueGraph[edge[0]].add(edge[1]);
        }

        int[] answer = new int[n];
        Arrays.fill(answer, -1);

        // visited[node][color]: whether node was visited
        // with the specified color as the last edge
        boolean[][] visited = new boolean[n][2];

        // Queue stores {node, lastEdgeColor, distance}
        Queue<int[]> queue = new LinkedList<>();

        // Start at node 0 with no previous edge
        queue.offer(new int[]{0, 0, 0});
        queue.offer(new int[]{0, 1, 0});

        visited[0][0] = true;
        visited[0][1] = true;

        answer[0] = 0;

        while (!queue.isEmpty()) {
            int[] current = queue.poll();

            int node = current[0];
            int lastColor = current[1];
            int distance = current[2];

            List<Integer> nextNodes;

            // If the last edge was blue, the next must be red
            if (lastColor == 1) {
                nextNodes = redGraph[node];
            } else {
                // If the last edge was red, the next must be blue
                nextNodes = blueGraph[node];
            }

            for (int next : nextNodes) {
                int nextColor = 1 - lastColor;

                if (!visited[next][nextColor]) {
                    visited[next][nextColor] = true;

                    if (answer[next] == -1) {
                        answer[next] = distance + 1;
                    }

                    queue.offer(new int[]{
                        next,
                        nextColor,
                        distance + 1
                    });
                }
            }
        }

        return answer;
    }
}

Input
n =
3
redEdges =
[[0,1],[1,2]]
blueEdges =
[]
Output
[0,1,-1]
