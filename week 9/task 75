import java.util.*;

class Solution {
    public int[][] kClosest(int[][] points, int k) {
        Arrays.sort(points, (a, b) ->
            Integer.compare(
                a[0] * a[0] + a[1] * a[1],
                b[0] * b[0] + b[1] * b[1]
            )
        );

        return Arrays.copyOfRange(points, 0, k);
    }
}

Input
points =
[[1,3],[-2,2]]
k =
1
Output
[[-2,2]]
