class Solution {
    int count = 0;

    public int kthSmallest(TreeNode root, int k) {
        return inorder(root, k);
    }

    private int inorder(TreeNode root, int k) {

        if (root == null) {
            return -1;
        }

        // Go to left subtree
        int left = inorder(root.left, k);

        if (left != -1) {
            return left;
        }

        // Visit current node
        count++;

        if (count == k) {
            return root.val;
        }

        // Go to right subtree
        return inorder(root.right, k);
    }
}

Input
root =
[3,1,4,null,2]
k =
1
Output
1
